# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

# Auth secrets
# ACCESS_TOKEN_SECRET must be BASE64 that decodes to at least 32 bytes (256 bits).
# Generate one with: openssl rand -base64 32
ACCESS_TOKEN_SECRET="replace-me-with-output-of-openssl-rand-base64-32"

JWT_ISSUER="http://auth.host:port"
JWT_AUDIENCE="http://api.host:port/protected"
